# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789,987654321

# Sites for cache warmup (comma-separated URLs)
WARMUP_SITES=https://example.com,https://example2.com

# Sites for uptime monitoring (comma-separated URLs)
UPTIME_SITES=https://example.com,https://example2.com

# Domains for WHOIS monitoring (comma-separated, no https://)
MONITORED_DOMAINS=example.com,example2.com

# Intervals (minutes)
WARMUP_INTERVAL=30
UPTIME_CHECK_INTERVAL=15
DOMAIN_CHECK_INTERVAL=1440

# HTTP settings
DELAY_BETWEEN_REQUESTS=10
REQUEST_TIMEOUT=15
MAX_RETRIES=3
# Optional: identify yourself to site owners, e.g. "MoonWatcher/0.1 (+https://github.com/cyborgmachine/moon-watcher)"
# USER_AGENT=
DOMAIN_ALERT_DAYS=30,14,7,3,1

# Uptime: confirm a failure before alerting
# Site is reported DOWN only after N consecutive failed checks (1 = alert on the first failure)
UPTIME_FAIL_THRESHOLD=2
# Seconds between those confirmation checks
UPTIME_RETRY_DELAY=30

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=moon_watcher
DB_USER=watcher
# Required. Use a long random value.
DB_PASSWORD=change_me_in_production

# Alert cooldown (seconds)
# Anti-spam for repeating alerts (resource thresholds, container restart loops).
# State changes (site down/up, container down/recovered, domain expiry) are never suppressed.
ALERT_COOLDOWN=900

# Data retention
LOG_RETENTION_DAYS=30

# Docker & server resource monitoring
DOCKER_MONITORING=true
# GID of the docker socket on the host:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# Containers to skip (comma-separated, wildcards allowed: tmp-*)
IGNORED_DOCKER_CONTAINERS=
# Check every N minutes; alert only after N consecutive checks above a threshold
RESOURCE_CHECK_INTERVAL=2
RESOURCE_ALERT_CHECKS=3
# Host thresholds (%)
THRESHOLD_CPU=90
THRESHOLD_RAM=90
THRESHOLD_DISK=90
# Container thresholds (%). CPU is relative to the container's CPU limit if set, else to one core
THRESHOLD_CONTAINER_CPU=90
THRESHOLD_CONTAINER_MEM=90
# Disk path to measure (set to /hostfs if you mount the host root, see docker-compose.yml)
HOST_DISK_PATH=/
# Include the last N log lines in "container down" alerts (0 = off)
DOCKER_ALERT_LOG_LINES=0
